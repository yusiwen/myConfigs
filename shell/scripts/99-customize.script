#!/usr/bin/env bash

# Source any extended scripts stored in $HOME/.exports/ folder.
# zsh aborts on an unmatched glob, so the loop lives in a function where
# nonomatch can be scoped locally; [ -f ] keeps directories out of `source`.
_source_custom_exports() { # {{{
  [ -n "${ZSH_VERSION:-}" ] && setopt localoptions nonomatch
  local script
  for script in "$HOME"/.exports/*.script; do
    [ -f "$script" ] || continue
    # shellcheck source=/dev/null
    source "$script"
  done
} # }}}

if [ -d "$HOME"/.exports ]; then
  _source_custom_exports
fi
unset -f _source_custom_exports

# vim: foldmethod=marker :
