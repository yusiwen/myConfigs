#!/usr/bin/env bash

# {{{ OS detection
# `uname -s` is authoritative: WINDIR is also present in WSL when WSLENV
# forwards it, and using it as the primary check marked WSL as Windows_NT.
_os_uname=$(uname -s 2>/dev/null || true)
case "$_os_uname" in
  MINGW*|MSYS*|CYGWIN*) OS='Windows_NT' ;;
  '')
    if [ -n "${WINDIR:-}" ]; then
      OS='Windows_NT'
    else
      OS='unknown'
    fi
    ;;
  *) OS=$_os_uname ;;
esac
unset _os_uname
export OS
# }}}

# {{{ Locale
# Policy: this shell is English and UTF-8. LC_ALL is never exported — it
# outranks LANG and every LC_* category, so it would also neutralise
# per-command overrides such as `LC_TIME=zh_CN.UTF-8 date`.
# The locale is pinned only when `locale -a` lists it: forcing a locale the
# host does not install makes libc fall back to C and silently break UTF-8.
_locale_en=''
if command -v locale >/dev/null 2>&1; then
  for _locale in en_US.UTF-8 en_US.utf8 C.UTF-8 C.utf8; do
    if locale -a 2>/dev/null | grep -qix "$_locale"; then
      _locale_en=$_locale
      break
    fi
  done
fi
if [ -n "$_locale_en" ]; then
  unset LC_ALL
  export LANG="$_locale_en"
  export LC_CTYPE="$_locale_en" LC_COLLATE="$_locale_en"
  export LC_MESSAGES="$_locale_en" LC_MONETARY="$_locale_en"
  export LC_NUMERIC="$_locale_en" LC_TIME="$_locale_en"
  export LANGUAGE=en_US:en
fi
unset _locale_en _locale
# }}}

# {{{ Distribution Information
# Recompute on every source: a DISTRO inherited from a parent shell must not
# leak into this session.
DISTRO=''
if [ "$OS" = 'Linux' ]; then
  # Prefer the LSB short ID when the tool is actually installed; the presence
  # of /etc/lsb-release does not guarantee the binary.
  if command -v lsb_release >/dev/null 2>&1; then
    DISTRO=$(lsb_release -si 2>/dev/null || true)
  fi
  case $DISTRO in
    n/a|'') DISTRO='' ;;
  esac

  # Fall back to os-release (ID first, then NAME). Do not truncate the name:
  # "Linux Mint" is not "Linux".
  if [ -z "$DISTRO" ]; then
    for _os_release in /etc/os-release /usr/lib/os-release; do
      [ -r "$_os_release" ] || continue
      _id=$(awk -F= '/^ID=/{gsub(/"/, "", $2); print $2; exit}' "$_os_release")
      _name=$(awk -F= '/^NAME=/{gsub(/"/, "", $2); print $2; exit}' "$_os_release")
      # Normalize the lower-case IDs used by the scripts in this repo; any
      # other distro keeps its full NAME (or ID when NAME is absent).
      case "$_id" in
        ubuntu) DISTRO='Ubuntu' ;;
        debian) DISTRO='Debian' ;;
        centos) DISTRO='CentOS' ;;
        manjaro|manjaro-arm) DISTRO='Manjaro' ;;
        linuxmint) DISTRO='Linux Mint' ;;
        deepin) DISTRO='Deepin' ;;
        openwrt) DISTRO='OpenWrt' ;;
        openeuler) DISTRO='openEuler' ;;
        *) DISTRO="${_name:-$_id}" ;;
      esac
      break
    done
    unset _os_release _id _name
  fi
fi
export DISTRO="${DISTRO:-$OS}"
#}}}

# vim: foldmethod=marker :
