#!/usr/bin/env bash

whichv() { # {{{
  # Not `path`: in zsh that is a tied array for PATH, so a local `path` would
  # empty PATH for the duration of the function.
  local name cmd_path
  for name in "$@"; do
    type "$name" 2>&1
    cmd_path=$(command -v "$name" 2>/dev/null) || continue
    [ -f "$cmd_path" ] && file "$cmd_path"
  done
} # }}}

function check_command() { # {{{
  if type "$1" >/dev/null 2>&1; then
    true
  else
    false
  fi
} # }}}

# Fail early with one message instead of one "command not found" per docker call.
function _docker_require() { # {{{
  if ! check_command docker; then
    echo 'docker is not found, please install docker first.' >&2
    return 1
  fi
} # }}}

du1() { du -h -d 1 "$@" | sort -k 1,1hr -k 2,2f; }

# Purge all rc packages
purgerc() { # {{{
  RC=$(dpkg -l | grep "^rc" | cut -d ' ' -f 3)
  if [ -z "$RC" ]; then
    echo "No 'rc' status package was found."
    return 1
  fi
  echo "$RC"
  printf "Purge all [Y/n]? "
  read -rs choice
  case $choice in
  Y | "" | y)
    echo "$RC" | xargs sudo dpkg --purge
    ;;
  *)
    return 1
    ;;
  esac
} # }}}

# Extract some pages from a PDF file.
pdfpextr() { # {{{
  # this function uses 3 arguments:
  #   $1 is the first page of the range to extract
  #   $2 is the last page of the range to extract
  #   $3 is the input file
  #   output file will be named "inputfile_pXX-pYY.pdf"
  if [ $# -ne 3 ]; then
    echo 'Usage: pdfpextr start_page end_page input_file'
    echo '  output file wille be named "{input_file}_pXX-pYY.pdf"'
    return 1
  fi
  gs -sDEVICE=pdfwrite -dNOPAUSE -dBATCH -dSAFER \
    -dFirstPage="${1}" \
    -dLastPage="${2}" \
    -sOutputFile="${3%.pdf}_p${1}-p${2}.pdf" \
    "${3}"
} # }}}

# Fix pdf embedded fonts problem
#   see: http://stackoverflow.com/a/10282269/3387137
pdffixfont() { # {{{
  # this function uses 2 arguments:
  #   $1 is the original file with embedded fonts problem
  #   $2 is the output file
  if [ $# -ne 2 ]; then
    echo 'Usage: pdffixfont input_file output_file'
    return 1
  fi
  gs -o "${2}" \
    -dPDFSETTINGS=/prepress \
    -sDEVICE=pdfwrite \
    "${1}"
} # }}}

# Split media file by cue
#   see: http://en.linuxreviews.org/HOWTO_splitt_lossless_audio_files_(ape,_flac,_wv,_wav)_using_.cue_files
splitbycue() { # {{{
  # this function uses 3 arguments:
  #   $1 is the cue file
  #   $2 is the media file, can be .ape/.flac/.wav
  #   $3 is the output format, can be 'wav','flac'...
  if [ $# -ne 3 ]; then
    echo 'Usage: splitbycue cue_file media_file output_format'
    return 1
  fi

  cuebreakpoints "${1}" | shnsplit -o "${3}" "${2}"
} # }}}

# Convert all FLAC files in current directory to ALAC
#   see: https://gist.github.com/vol4ok/2587886
flac2alac() { # {{{
  local f found=0
  # zsh aborts on an unmatched glob unless nomatch is disabled; bash leaves the
  # literal pattern behind, which the -e check below filters out.
  [ -n "${ZSH_VERSION:-}" ] && setopt localoptions nonomatch
  for f in *.flac; do
    [ -e "$f" ] || continue
    found=1
    ffmpeg -i "./$f" -acodec alac "./${f%.flac}.m4a"
  done
  if [ "$found" -eq 0 ]; then
    echo 'No .flac files found.' >&2
    return 1
  fi
} # }}}

# Add folder to $PATH if it doesn't exist in it
#   see: http://superuser.com/questions/39751/add-directory-to-path-if-its-not-already-there
addpath() { # {{{
  if [ -d "${1}" ] && [[ ":$PATH:" != *":${1}:"* ]]; then
    PATH="${PATH:+"$PATH:"}$1"
  fi
} # }}}

# Find largest directories or files in current folder
maxs() { # {{{
  numbers=10
  type='d'
  re='^[0-9]+$'
  if [ $# -eq 0 ]; then
    numbers=10
    type='d'
  elif [ $# -eq 1 ]; then
    if [ "$1" = "-h" ]; then
      echo "maxs [-fdh] [NUMBER]"
      return 0
    fi

    if ! [[ "${1}" =~ $re ]]; then
      echo "error: Not a number: ${1}" >&2
      return 1
    fi
    numbers="${1}"
    type='d'
  else
    if [ "${1}" = "-f" ]; then
      type='f'
    elif [ "${1}" = "-d" ]; then
      type='d'
    else
      echo "error: Wrong option: ${1}" >&2
      return 1
    fi

    if ! [[ "${2}" =~ $re ]]; then
      echo "error: Not a number: ${2}" >&2
      return 1
    fi
    numbers="${2}"
  fi

  find . -type "$type" -print0 | xargs -0 du | sort -n | tail -"$numbers" | cut -f2 | xargs -I{} du -sh {}
} # }}}

# Check if running in WSL
is_running_in_wsl() { # {{{
  if [ -n "$(uname -r | sed -n 's/.*\( *Microsoft *\).*/\1/ip')" ]; then
    echo "1"
  else
    echo "0"
  fi
} # }}}

# Git {{{
# https://polothy.github.io/post/2019-08-19-fzf-git-checkout/
fzf-git-branch() { # {{{
  git rev-parse HEAD >/dev/null 2>&1 || return

  git branch --color=always --all --sort=-committerdate |
    grep -v HEAD |
    fzf --height 50% --ansi --no-multi --preview-window right:65% \
      --preview 'git log -n 50 --color=always --date=short --pretty="format:%C(auto)%cd %h%d %s" $(sed "s/.* //" <<< {})' |
    sed 's/^[*[:space:]]*//'
} # }}}

fzf-git-checkout() { # {{{
  git rev-parse HEAD >/dev/null 2>&1 || return

  local current_branch
  current_branch=$(git branch --show-current)

  if [ -n "$(git status -s)" ]; then
    echo -n 'The working directory is dirty, stash before checkout? [YES|no] '
    read -r yn

    case $yn in
      "" | yes | YES | Yes | y | Y) git stash -u || return 1 ;;
      *) ;;
    esac
  fi

  local branch

  branch=$(fzf-git-branch)
  if [[ "$branch" = "" ]]; then
    echo "No branch selected."
    return
  fi
  
  echo -n "Checkout specific commit? [yes|NO] "
  read -r yn

  local get_commit=0
  case $yn in
    yes | YES | Yes | y | Y) get_commit=1;;
    *) ;;
  esac

  local commit=""
  if [ $get_commit = 1 ]; then
    commit=$(git log "$branch" --color=always --date=short --pretty="format:%C(auto)%cd %h%d %s" | fzf | cut -d' ' -f 2)
  fi

  if [[ "$commit" = "" ]]; then
    commit="$branch"
  fi

  if [ "$commit" = "$current_branch" ]; then
    return
  fi

  # If branch name starts with 'remotes/' then it is a remote branch. By
  # using --track and a remote branch name, it is the same as:
  # git checkout -b branchName --track origin/branchName
  if [[ "$commit" = 'remotes/'* ]]; then
    git checkout --track $commit
  else
    git checkout $commit
  fi
} # }}}

# https://gist.github.com/junegunn/f4fca918e937e6bf5bad
git-fuzzy-diff() { # {{{
  local PREVIEW_PAGER="less --tabs=4 -Rc"

  local REVISION="${1:-}"
  if [ "$REVISION" = '.' ]; then
    REVISION='HEAD'
  fi

  # Don't just diff the selected file alone, get related files first using
  # '--name-status -R' in order to include moves and renames in the diff.
  # See for reference: https://stackoverflow.com/q/71268388/3018229
  local PREVIEW_COMMAND='git diff --color=always '$REVISION' -- \
		$(echo $(git diff --name-status -R '$@' | grep {}) | cut -d" " -f 2-) \
		| '$PREVIEW_PAGER

  git diff --submodule --word-diff --name-only "$@" |
    fzf --exit-0 --preview "${PREVIEW_COMMAND}" \
      --preview-window=top:85%
} # }}}

git-fuzzy-log() { # {{{
  local PREVIEW_COMMAND='f() {
		set -- $(echo -- "$@" | grep -o "[a-f0-9]\{7\}")
		[ $# -eq 0 ] || (
			git show --no-patch --color=always $1
			echo
			git show --stat --format="" --color=always $1 |
			while IFS= read -r line; do
				tput dim
				printf " %s\n" "$line" | sed "s/$(printf "\033")\[m/$(printf "\033")[2m/g"
				tput sgr0
			done |
			awk "1; END { print \"\" }"
		)
	}; f {}'

  git log --graph --color=always --format="%C(auto)%h %s%d " |\
    fzf --no-sort --tiebreak=index \
      --preview "${PREVIEW_COMMAND}" --preview-window=top:15,hidden |\
    sed 's/^[^[:alnum:]]*//' | awk '{ print $1 }'
} # }}}
# }}}

# using ripgrep combined with preview
# find-in-file - usage: fif <searchTerm>
fif() { # {{{
  if [ ! "$#" -gt 0 ]; then
    echo "Need a string to search for!"
    return 1
  fi
  rg --files-with-matches --no-messages "$1" | fzf --preview "highlight -O ansi -l {} 2> /dev/null | rg --colors 'match:bg:yellow' --ignore-case --pretty --context 10 '$1' || rg --ignore-case --pretty --context 10 '$1' {}"
} # }}}

# Github {{{
get_latest_release() {
  if ! check_command curl; then
    echo 'curl is not found, please install curl first.' >&2
    return 1
  fi
  curl --fail --silent --show-error --location \
    "https://api.github.com/repos/${1:-}/releases/latest" | # Get latest release from GitHub api
    sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n 1  # Pluck JSON value
}
#}}}

# Python {{{
function _pip() {
  if check_command pip_search; then
    if [ "${1:-}" = "search" ]; then
      shift
      pip_search "$@"
    else
      pip "$@"
    fi
  else
    pip "$@"
  fi
}

function _pip3() {
  if check_command pip_search; then
    if [ "${1:-}" = "search" ]; then
      shift
      pip_search "$@"
    else
      pip3 "$@"
    fi
  else
    pip3 "$@"
  fi
}

function _pip_is_pip3() {
  _pip3 "$@"
}

function _python_is_python3() {
  python3 "$@"
}
#}}}

# Docker {{{
docker-fuzzy-image-ls() {
  _docker_require || return 1
  local cid
  # No .50/.20 precision: truncating the repository made `-t` build
  # `docker rmi` arguments from the truncated name.
  cid=$(docker image ls --format '{{.ID | printf "%-15s"}} {{.Repository | printf "%-50s"}}\t{{.Tag | printf "%-20s"}}\t{{.Size}}' |\
    fzf --no-sort --tiebreak=index \
        --preview 'docker image inspect {1}' --preview-window=top:15,hidden \
        --preview-label='image details')

  if [ -n "$cid" ]; then
    if [ "${1:-}" = '-t' ]; then
      echo "$cid" | awk '{ print $2":"$3 }'
    else
      echo "$cid" | awk '{ print $1 }'
    fi
  fi
}

docker-fuzzy-container-ls() {
  _docker_require || return 1
  local format="--format '{{.ID | printf \"%-15s\"}} {{.Names | printf \"%-40.40s\"}}\t{{.Status | printf \"%-16.16s\"}} {{.Image}}'"
  local arguments
  arguments="container ls $format"
  if [ -n "$1" ]; then
    arguments="container ls $1 $format"
  fi
  local command="docker $arguments"

  eval "$command" |\
    fzf --no-sort --tiebreak=index \
        --preview 'docker container inspect {1}' --preview-window=top:15,hidden \
        --preview-label='container details' |\
    cut -d ' ' -f 1
}

docker-get-pid-by-container-id() {
  _docker_require || return 1
  local container_id
  container_id=$(docker-fuzzy-container-ls)
  [ -n "$container_id" ] || return 1
  docker inspect --format '{{.State.Pid}}' "$container_id"
}

docker-fuzzy-network-ls() {
  _docker_require || return 1
  docker network ls --format '{{.ID | printf "%-15s"}} {{.Name | printf "%-20.20s"}}\t{{.Driver}}\t{{.Scope}}' |\
    fzf --no-sort --tiebreak=index \
        --preview 'docker network inspect {1}' --preview-window=top:15,hidden \
        --preview-label='network details' |\
    cut -d ' ' -f 1
}

docker-veth-ls() {
  _docker_require || return 1

  for container in $(docker ps -q); do
    local container_name=
    container_name=$(docker ps --format '{{.Names}}' -f "id=$container")
    local iflink=
    iflink=$(docker exec -it "$container" cat /sys/class/net/eth0/iflink)
    iflink=$(echo "$iflink" | tr -d '\r')
    local veth=
    veth=$(grep -l "$iflink" /sys/class/net/veth*/ifindex)
    veth=$(echo "$veth" | sed -e 's;^.*net/\(.*\)/ifindex$;\1;')
    echo "$container : $veth : $container_name"
done
}
#}}}

# Select a docker container to execute command
function de() { # {{{
  _docker_require || return 1
  local cid
  cid=$(docker-fuzzy-container-ls)

  [ -n "$cid" ] && docker exec "$cid" "$@"
} # }}}
# Select a docker container to start and attach to
function da() { # {{{
  _docker_require || return 1
  local cid
  cid=$(docker-fuzzy-container-ls -a)

  [ -n "$cid" ] && docker start "$cid" && docker attach "$cid"
} # }}}
# Select a running docker container to stop
function ds() { # {{{
  _docker_require || return 1
  local cid
  cid=$(docker-fuzzy-container-ls)

  [ -n "$cid" ] && docker stop "$cid"
} # }}}
# Select docker containers to remove
function _drm() { # {{{
  _docker_require || return 1
  local cid
  cid=$(docker-fuzzy-container-ls -a)
  [ -n "$cid" ] && docker rm "$cid"
} # }}}
# Select a docker image or images to remove
function _drmi() { # {{{
  _docker_require || return 1
  local cid
  cid=$(docker-fuzzy-image-ls -t)
  [ -n "$cid" ] && docker rmi "$cid"
} # }}}

function _docker_compose_project_dir() { # {{{
  _docker_require || return 1

  if ! check_command jq; then
    echo 'jq is not found, please install jq first.' >&2
    return 1
  fi

  if ! check_command fzf; then
    echo 'fzf is not found, please install fzf first.' >&2
    return 1
  fi

  # An empty selection made the filter match every project, so `cd` could land
  # in a directory unrelated to what the user picked.
  local selection
  selection=$(docker compose ls -q | fzf)
  [ -n "$selection" ] || return 1

  local project_path
  project_path=$(docker compose ls --filter "name=$selection" --format json | jq -r '.[0].ConfigFiles // empty')
  [ -n "$project_path" ] || return 1
  dirname -- "$project_path"
} # }}}

function _docker_compose_change_dir_to_project() { # {{{
  local target
  target=$(_docker_compose_project_dir) || return 1
  [ -n "$target" ] || return 1
  cd "$target"
} # }}}

function _docker_images_group_by_id() { # {{{
  _docker_require || return 1
  local -a rows running
  local row id repo tag name_with_tag suffix running_image
  local last_id=''
  # Keep IFS local, see _docker_images_group_by_name.
  local IFS=$'\n'

  # One `docker images` call with '|'-separated fields (IDs, repositories and
  # tags never contain '|'). The previous version ran `grep "${id}"` for every
  # ID, which matched it as a regex anywhere in the row, and parsed each row
  # with GNU-only `sed 's/...\s.../'` (BSD sed treats `\s` as a literal "s").
  rows=( $(docker images --format '{{.ID}}|{{.Repository}}|{{.Tag}}' | sort -t'|' -k1,1 -k2,2 -k3,3) )

  # Snapshot running images once instead of one `docker container ls` per image.
  running=( $(docker container ls --format '{{.Image}}') )

  for row in "${rows[@]}"; do
    id=${row%%|*}
    row=${row#*|}
    repo=${row%%|*}
    tag=${row#*|}
    name_with_tag="$repo:$tag"

    suffix=''
    for running_image in "${running[@]}"; do
      if [ "$running_image" = "$name_with_tag" ]; then
        suffix=" (${BOLD_YELLOW}running${NC})"
        break
      fi
    done

    if [ "$last_id" != "$id" ]; then
      printf '%b%s%b - %s%b\n' "$BOLD_GREEN" "$id" "$NC" "$name_with_tag" "$suffix"
    else
      printf '%*s%s%b\n' 15 '' "$name_with_tag" "$suffix"
    fi

    last_id=$id
  done
} # }}}

function _docker_images_group_by_name() { # {{{
  _docker_require || return 1
  local -a rows running
  local row id name_with_tag name_without_tag suffix running_image
  local max_name_length=0
  local previous_name_without_tag=''
  local last_id=''
  # IFS must be local: `IFS=$'\n' arr=(...)` is two plain assignments, not a
  # temporary environment (zsh and bash both), so an unlocalised IFS leaks into
  # the interactive shell. A newline-only IFS then breaks ZLE and completion
  # with errors like "(eval):zle:1: not enough arguments for -C"
  # (zsh-autosuggestions issue #825).
  local IFS=$'\n'

  # Fetch everything in one pass, with ID, repository and tag separated by '|'
  # (a character none of them can contain). The previous version ran
  # `grep "$name"` for every repository, which matched the name as a regex
  # anywhere in the row: "sonarqube" also matched "sonarsource/sonarqube-mcp",
  # so that image was printed once per matching repository (i.e. twice).
  # The sort is stable, so within a repository docker's own order (newest first)
  # is kept.
  rows=( $(docker images --format '{{.ID}}|{{.Repository}}|{{.Tag}}' | sort -t'|' -k2,2 -s) )

  # Snapshot the running containers' image references once, instead of running
  # `docker container ls` for every single image.
  running=( $(docker container ls --format '{{.Image}}') )

  for row in "${rows[@]}"; do
    name_with_tag="${row#*|}"
    name_with_tag="${name_with_tag%%|*}:${name_with_tag#*|}"
    if (( ${#name_with_tag} > max_name_length )); then
      max_name_length=${#name_with_tag}
    fi
  done

  for row in "${rows[@]}"; do
    id=${row%%|*}
    name_with_tag=${row#*|}
    name_without_tag=${name_with_tag%%|*}
    name_with_tag="$name_without_tag:${name_with_tag#*|}"

    if [ "$name_without_tag" != "$previous_name_without_tag" ]; then
      printf "\e[1;2m%${max_name_length}s\e[m\n" "-" | tr ' ' '-'
      last_id=''
      previous_name_without_tag="$name_without_tag"
    fi

    suffix=''
    for running_image in "${running[@]}"; do
      if [ "$running_image" = "$name_with_tag" ]; then
        suffix="(${BOLD_YELLOW}running${NC})"
        break
      fi
    done

    if [ "$last_id" != "$id" ]; then
      printf "%${max_name_length}s %12b %b\n" "$name_with_tag" "${BOLD_GREEN}$id${NC}" "$suffix"
    else
      printf "%${max_name_length}s %12s %b\n" "$name_with_tag" " " "$suffix"
    fi

    last_id="$id"
  done
} # }}}

function _docker_search_tags() { # {{{
  if ! check_command jq; then
    echo 'jq is not found, please install jq first.' >&2
    return 1
  fi
  if ! check_command wget; then
    echo 'wget is not found, please install wget first.' >&2
    return 1
  fi

  if [ -z "${1:-}" ]; then
    echo 'Please input search keyword.' >&2
    return 1
  fi

  local reference="$1"
  local namespace repo

  # `cut -d/ -f2` turned "ghcr.io/org/repo" into namespace "org", which is not
  # a Docker Hub namespace at all. Only Docker Hub's [namespace/]repo form can
  # be looked up here.
  repo=${reference##*/}
  if [ "$repo" = "$reference" ]; then
    namespace='library'
  else
    namespace=${reference%/*}
    case $namespace in
      *.*|*:*|localhost)
        echo "Only Docker Hub repositories are supported (got '$reference')." >&2
        return 1
        ;;
    esac
  fi

  wget -q -O - "https://hub.docker.com/v2/namespaces/$namespace/repositories/$repo/tags" | jq -r '.results[].name'
} # }}}

function _docker_pull_tags() { # {{{
  local reference="${1:-}"
  if [ -z "$reference" ]; then
    echo 'Usage: dpt <repository>' >&2
    return 1
  fi
  _docker_require || return 1
  if ! check_command fzf; then
    echo 'fzf is not found, please install fzf first.' >&2
    return 1
  fi

  local tag
  tag=$(_docker_search_tags "$reference" | fzf)
  [ -n "$tag" ] || return 1
  docker pull "$reference:$tag"
} # }}}

function _docker_run_into_shell() { # {{{
  _docker_require || return 1
  if ! check_command fzf; then
    echo 'fzf is not found, please install fzf first.' >&2
    return 1
  fi

  local repo
  repo=$(docker images --format '{{.Repository}}:{{.Tag}}' | fzf)
  [ -n "$repo" ] || return 1
  docker run --rm -i -t --entrypoint=sh "$repo"
} # }}}

function _mvn_setting_switch() { # {{{
  if [ ! -d "$HOME"/.m2 ]; then
    return
  fi
  local settings
  settings=$(find "$HOME"/.m2/settings*.xml | fzf)
  [ -n "$settings" ] && mvn -s "$settings" "$@"
} # }}}

function _mvnd_setting_switch() { # {{{
  if [ ! -d "$HOME"/.m2 ]; then
    return
  fi
  local settings
  settings=$(find "$HOME"/.m2/settings*.xml | fzf)
  [ -n "$settings" ] && mvnd -s "$settings" "$@"
} # }}}

# GPG Preset Passphrase {{{
function gpg_agent_preset()
{
  local gpg_passphrase="$1"
  # authorize preset mechanism, in our context agent is not loaded yet.
  # echo allow-preset-passphrase  >> ~/.gnupg/gpg-agent.conf

  # Locate the helper instead of assuming the Debian path; Fedora, Arch and
  # macOS keep it elsewhere (or not at all).
  local preset
  preset=$(command -v gpg-preset-passphrase 2>/dev/null || true)
  [ -n "$preset" ] || preset='/usr/lib/gnupg/gpg-preset-passphrase'
  if [ ! -x "$preset" ]; then
    echo 'gpg-preset-passphrase not found, install GnuPG 2.1+ or add it to PATH.' >&2
    return 1
  fi
  if ! command -v gpg-connect-agent >/dev/null 2>&1; then
    echo 'gpg-connect-agent not found, install GnuPG 2.1+.' >&2
    return 1
  fi

  # this will start the agent ang give use keygripID
  local keygrip
  keygrip=( $(gpg-connect-agent -q 'keyinfo --list' /bye | awk '/KEYINFO/ { print $3 }') )

  local k
  for k in "${keygrip[@]}"
  do
    # printf, not echo: zsh's echo expands backslash escapes and would corrupt
    # passphrases containing \t, \n or \033.
    printf '%s\n' "$gpg_passphrase" | "$preset" --preset "$k"
  done
} # }}}

# https://github.com/ardnew/bash-busy/blob/main/busy.bash
# Usage: busy [delay] <prompt> <expression>
function busy() { # {{{
	# Define the animation frames in-order.
	#local -a frame=( '/' '-' '\' '|' )
	local -a frame=( ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏ )
	
	local delay='0.1s' # Animated frame duration
	local prompt       # Message displayed after frame animation

	# Test if first argument appears to be a sleep(1) duration.
	local pat='^([0-9](\.[0-9]*)?|[0-9]*\.[0-9]{1,})[smhd]?$'
	if [[ ${#} -gt 0 ]] && [[ "${1}" =~ ${pat} ]]; then
		delay=${1}
		prompt=${2}
		shift
		shift
	else
		prompt=${1}
		shift
	fi
	
	# Find the widest frame in the animation.
	local wide=0
	for s in "${frame[@]}"; do 
		[[ ${#s} -gt ${wide} ]] && wide=${#s}
	done

	local n=0
	printf ' %*s %s\r' ${wide} '' "${prompt}"
	while ! eval -- "${*}"; do
		printf ' %*s \r' ${wide} "${frame[((n=++n%${#frame[@]}))]}"
		sleep "${delay}"
	done
	# Clear the animation frame and prompt
	printf ' %*s %*s\r' ${wide} '' ${#prompt} ''
} # }}}

# {{{ Java
function link_jdk_version_to_latest_installed_dir() {
  local jdk_version="${1:-}"
  local jdk_installed
  if [ -z "$jdk_version" ] || [ -z "${SDKMAN_CANDIDATES_DIR:-}" ]; then
    return 1
  fi
  # The candidate glob may not match anything; zsh would abort on that.
  [ -n "${ZSH_VERSION:-}" ] && setopt localoptions nonomatch
  # `sort -r` is lexicographic: it picked 8.0.9 over 8.0.412.
  if [ "${OS:-}" = 'Darwin' ]; then
    jdk_installed="$(/bin/ls -d "$SDKMAN_CANDIDATES_DIR/java/$jdk_version"*zulu 2>/dev/null | sort -rV | head -1)"
  else
    jdk_installed="$(/usr/bin/ls -d "$SDKMAN_CANDIDATES_DIR/java/$jdk_version"*tem 2>/dev/null | sort -rV | head -1)"
  fi

  if [ -n "$jdk_installed" ]; then
    ln -sfnv "$jdk_installed" "$SDKMAN_CANDIDATES_DIR/java/$jdk_version"
  fi
}

function link_jdks() {
  if [ -e "$SDKMAN_CANDIDATES_DIR/java" ]; then
    link_jdk_version_to_latest_installed_dir 8
    link_jdk_version_to_latest_installed_dir 11
    link_jdk_version_to_latest_installed_dir 17
    link_jdk_version_to_latest_installed_dir 21
    link_jdk_version_to_latest_installed_dir 23
  fi
}
# }}}

# {{{ Clipbaord over OSC52
function clip() {
  local data
  data=$(base64 | tr -d '\n')
  printf "\033]52;c;%s\a" "$data"
}
# }}}

# {{{ AI agent CLIs
# API keys come from pass and are loaded on first use of the command, not at
# shell startup. These used to be a zinit atinit/atload pair on the gh-r
# installs of opencode and dsh; both binaries are installed by mise now.
function load_opencode_keys() {
  if [ -z "$HINDSIGHT_API_KEY" ] && command -v pass >/dev/null 2>&1; then
    export HINDSIGHT_API_KEY="$(pass memory.yusiwen.cn/secret_api_key 2>/dev/null)"
  fi
}

function load_dsh_keys() {
  if [ -z "$HINDSIGHT_API_KEY" ] && command -v pass >/dev/null 2>&1; then
    export HINDSIGHT_API_KEY="$(pass memory.yusiwen.cn/secret_api_key 2>/dev/null)"
  fi
  if [ -z "$WOLAI_API_KEY" ] && command -v pass >/dev/null 2>&1; then
    export WOLAI_API_KEY="$(pass www.wolai.com/mcp_key 2>/dev/null)"
  fi
}

# Functions rather than the old `alias opencode='... opencode'` one-liners: the
# recursion guard is explicit and arguments are passed through untouched.
function opencode() {
  load_opencode_keys
  command opencode "$@"
}

function dsh() {
  load_dsh_keys
  command dsh "$@"
}
# }}}

